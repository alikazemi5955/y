# این نسخه برای ایجنت‌ها به هیچ سرویس هوش مصنوعی خارجی وابسته نیست.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- امنیت / بازیابی رمز مدیر (فقط برای یک بار؛ بعد از ورود حذف کنید) ---
# ADMIN_RESET_USERNAME=admin
# ADMIN_RESET_PASSWORD=Set-a-strong-unique-password-here

# --- ثبت هوشمند کالا ---

# --- تأمین‌کننده همراه تل ---
# هرگز نام کاربری/رمز تأمین‌کننده را داخل کد یا Git قرار ندهید.
# HAMRAHTEL_PHONE=
# HAMRAHTEL_PASSWORD=
# AGENTS_API_KEY=
# --- Agent alerts ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SYNC_INTERVAL_MINUTES=5
